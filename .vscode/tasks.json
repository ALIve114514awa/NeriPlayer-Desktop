{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tauri-dev",
      "type": "shell",
      "command": "pnpm tauri dev",
      "options": { "cwd": "${workspaceFolder}" },
      "windows": {
        "options": { "env": { "PATH": "${env:USERPROFILE}\\.cargo\\bin;${env:PATH}" } }
      },
      "osx": {
        "options": { "env": { "PATH": "${env:HOME}/.cargo/bin:${env:PATH}" } }
      },
      "linux": {
        "options": { "env": { "PATH": "${env:HOME}/.cargo/bin:${env:PATH}" } }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Watching.*|.*Running.*|.*Compiling.*"
        }
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "vite-dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*ready in.*"
        }
      }
    }
  ]
}
