{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2021", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": [],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@amll-core/*": ["./vendor/applemusic-like-lyrics/packages/core/src/*"],
      "#interfaces": ["./vendor/applemusic-like-lyrics/packages/core/src/interfaces.ts"],
      "#utils/*": ["./vendor/applemusic-like-lyrics/packages/core/src/utils/*"],
      "#styles/*": ["./vendor/applemusic-like-lyrics/packages/core/src/styles/*"],
      "#lyric/*": ["./vendor/applemusic-like-lyrics/packages/core/src/lyric-player/*"],
      "#bg/*": ["./vendor/applemusic-like-lyrics/packages/core/src/bg-player/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "types/**/*.d.ts",
    "vendor/applemusic-like-lyrics/packages/core/src/interfaces.ts",
    "vendor/applemusic-like-lyrics/packages/core/src/lyric-player/**/*.ts",
    "vendor/applemusic-like-lyrics/packages/core/src/utils/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "src-tauri"]
}
